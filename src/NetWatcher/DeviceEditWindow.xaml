<Window x:Class="NetWatcher.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Edit.Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Detected info -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Edit.Identity}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{StaticResource Col.Mac}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MacBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Text="{StaticResource Col.Ip}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="IpBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock Grid.Row="2" Text="{StaticResource Col.Vendor}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="VendorBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock Grid.Row="3" Text="{StaticResource Col.Hostname}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="HostBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock Grid.Row="4" Text="{StaticResource Col.Ports}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="PortsBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock Grid.Row="5" Text="{StaticResource Col.FirstSeen}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="SeenBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                    <TextBlock Grid.Row="6" Text="{StaticResource Edit.IpHistory}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,10,0" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="HistoryBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                </Grid>
                <TextBlock x:Name="PrivateMacNote" Text="{DynamicResource Edit.PrivateMacNote}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Conflict}" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Registration -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Edit.Registration}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <CheckBox x:Name="KnownBox" Content="{DynamicResource Edit.Approved}" Margin="0,0,0,4" FontWeight="SemiBold" />
                <CheckBox x:Name="CriticalBox" Content="{DynamicResource Edit.Critical}" Margin="0,0,0,0" />
                <TextBlock Text="{DynamicResource Edit.CriticalHint}" FontSize="11" Foreground="{StaticResource Brush.Muted}" Margin="20,0,0,4" TextWrapping="Wrap" />
                <CheckBox x:Name="MutedBox" Content="{DynamicResource Edit.Muted}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{StaticResource Col.Name}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" />
                    <TextBlock Grid.Row="1" Text="{StaticResource Col.Owner}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="OwnerBox" />
                    <TextBlock Grid.Row="2" Text="{StaticResource Col.Location}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocationBox" />
                    <TextBlock Grid.Row="3" Text="{StaticResource Col.Type}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TypeBox" IsEditable="True" Margin="0,3" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Edit.TypeHint}" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                    <TextBlock Grid.Row="5" Text="{StaticResource Col.ReservedIp}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="ReservedBox" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Edit.ReservedHint}" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                    <TextBlock Grid.Row="7" Text="{StaticResource Col.Notes}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,10,0" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn.Save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="{DynamicResource Btn.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
