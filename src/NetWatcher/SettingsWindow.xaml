<Window x:Class="NetWatcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="600" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Btn.Save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="{DynamicResource Btn.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource Section}" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="{DynamicResource Settings.StartWithWindows}" />
                        <TextBlock Text="{DynamicResource Settings.StartWithWindowsHint}" Style="{StaticResource Hint}" />
                        <CheckBox x:Name="CloseToTrayBox" Content="{DynamicResource Settings.CloseToTray}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Lbl.AutoScan}" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ScanIntervalBox" Width="60" />
                            <TextBlock Text="{DynamicResource Lbl.Minutes}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Network}" Style="{StaticResource Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.Interface}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Column="1" x:Name="InterfaceBox" Margin="0,3" DisplayMemberPath="Item2" SelectedValuePath="Item1" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Settings.ScanRange}" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="RangeBox" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Settings.ScanRangeHint}" Style="{StaticResource Hint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Notifications}" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AlertNewBox" Content="{DynamicResource Settings.AlertNew}" />
                        <CheckBox x:Name="AlertUnknownBox" Content="{DynamicResource Settings.AlertUnknown}" />
                        <CheckBox x:Name="AlertConflictBox" Content="{DynamicResource Settings.AlertConflict}" />
                        <CheckBox x:Name="AlertCriticalBox" Content="{DynamicResource Settings.AlertCritical}" />
                        <CheckBox x:Name="AlertInternetBox" Content="{DynamicResource Settings.AlertInternet}" />
                        <TextBlock Text="{DynamicResource Settings.MuteHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Health -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Health}" Style="{StaticResource Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.CheckEvery}" Style="{StaticResource Label}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="HealthIntervalBox" Width="70" Margin="0,3" />
                                <TextBlock Text="{DynamicResource Settings.Seconds}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Settings.Targets}" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TargetsBox" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Settings.TargetsHint}" Style="{StaticResource Hint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Data}" Style="{StaticResource Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings.KeepEvents}" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" x:Name="EventDaysBox" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Settings.Days}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Settings.KeepHealth}" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HealthDaysBox" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Settings.Days}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.KeepBackups}" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BackupsBox" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Settings.Weekly}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="LastBackupText" Style="{StaticResource Hint}" Margin="0,8,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Settings.BackupNow}" Click="BackupNow_Click" />
                            <Button Content="{DynamicResource Settings.OpenBackups}" Click="OpenBackups_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
