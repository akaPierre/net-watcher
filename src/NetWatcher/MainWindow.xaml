<Window x:Class="NetWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetWatcher.ViewModels"
        xmlns:m="clr-namespace:NetWatcher.Models"
        xmlns:controls="clr-namespace:NetWatcher.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{DynamicResource App.Title}"
        Width="1440" Height="800" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sys:Int32 x:Key="Hours1">1</sys:Int32>
        <sys:Int32 x:Key="Hours6">6</sys:Int32>
        <sys:Int32 x:Key="Hours24">24</sys:Int32>
        <sys:Int32 x:Key="Hours168">168</sys:Int32>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- ===== Header ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource App.Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding NetworkText}" Foreground="{StaticResource Brush.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Btn.ScanNow}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanNowCommand}" />
                <Button Content="{DynamicResource Btn.Export}" Click="Export_Click" />
                <Button Content="{DynamicResource Btn.UpdateVendors}" Command="{Binding UpdateVendorsCommand}" />
                <Button Content="{DynamicResource Btn.Settings}" Click="Settings_Click" />
                <TextBlock Text="{DynamicResource Lbl.AutoScan}" VerticalAlignment="Center" Margin="8,0,6,0" />
                <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding AutoScanMinutes}"
                          Width="55" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Lbl.Minutes}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{StaticResource Brush.Muted}" />
            </StackPanel>
        </Grid>

        <!-- ===== Summary cards ===== -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,10">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Brush.Online}" />
                    <TextBlock Text="{DynamicResource Sum.Online}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding UnknownCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Brush.Unknown}" />
                    <TextBlock Text="{DynamicResource Sum.Unknown}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Brush.Conflict}" />
                    <TextBlock Text="{DynamicResource Sum.Conflicts}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding KnownCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Brush.Known}" />
                    <TextBlock Text="{DynamicResource Sum.Known}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatNumber}" />
                    <TextBlock Text="{DynamicResource Sum.Total}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Status bar ===== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Height="8" Value="{Binding ScanProgress}"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ===== Tabs ===== -->
        <TabControl Padding="8">

            <!-- Devices -->
            <TabItem Header="{DynamicResource Tab.Devices}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Lbl.Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4,3" />
                        <TextBlock Text="{DynamicResource Lbl.Show}" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <ComboBox SelectedIndex="{Binding FilterIndex}" Width="160">
                            <ComboBoxItem Content="{DynamicResource Filter.All}" />
                            <ComboBoxItem Content="{DynamicResource Filter.Online}" />
                            <ComboBoxItem Content="{DynamicResource Filter.Unknown}" />
                            <ComboBoxItem Content="{DynamicResource Filter.Offline}" />
                            <ComboBoxItem Content="{DynamicResource Filter.Conflicts}" />
                            <ComboBoxItem Content="{DynamicResource Filter.Critical}" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Hint.DoubleClick}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource Brush.Muted}" />
                    </StackPanel>

                    <DataGrid x:Name="DeviceGrid"
                              ItemsSource="{Binding DevicesView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Extended"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                              BorderBrush="{StaticResource Brush.Border}"
                              RowHeight="26"
                              MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource Brush.UnknownRow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.ConflictRow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu.Edit}" Click="Edit_Click" FontWeight="SemiBold" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Menu.MarkKnown}"
                                          Command="{Binding MarkKnownCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource Menu.MarkUnknown}"
                                          Command="{Binding MarkUnknownCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Menu.CopyIp}" Click="CopyIp_Click" />
                                <MenuItem Header="{DynamicResource Menu.CopyMac}" Click="CopyMac_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Menu.Forget}" Click="Forget_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" SortMemberPath="IsOnline">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Offline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Online}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="26" SortMemberPath="IsCritical">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" ToolTip="{StaticResource Col.Critical}" Foreground="{StaticResource Brush.Accent}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                            <Setter Property="Text" Value="★" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{StaticResource Col.Ip}" Binding="{Binding Ip}" SortMemberPath="IpSortKey" Width="110" />
                            <DataGridTextColumn Header="{StaticResource Col.Name}" Binding="{Binding DisplayName}" Width="2*" MinWidth="170" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="{StaticResource Col.Type}" Binding="{Binding TypeText}" Width="1.3*" MinWidth="140" />
                            <DataGridTextColumn Header="{StaticResource Col.Vendor}" Binding="{Binding VendorText}" Width="1.6*" MinWidth="160" />
                            <DataGridTextColumn Header="{StaticResource Col.Hostname}" Binding="{Binding Hostname}" Width="1.3*" MinWidth="120" />
                            <DataGridTextColumn Header="{StaticResource Col.Mac}" Binding="{Binding Mac}" Width="130" FontFamily="Consolas" />
                            <DataGridTextColumn Header="{StaticResource Col.Owner}" Binding="{Binding Owner}" Width="1.1*" MinWidth="100" />
                            <DataGridTextColumn Header="{StaticResource Col.Location}" Binding="{Binding Location}" Width="1.1*" MinWidth="100" />
                            <DataGridTemplateColumn Header="{StaticResource Col.Known}" Width="80" SortMemberPath="IsKnown">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Known}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                            <Setter Property="Text" Value="✖" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Unknown}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{StaticResource Col.Ports}" Binding="{Binding OpenPorts}" Width="90" />
                            <DataGridTextColumn Header="{StaticResource Col.FirstSeen}" Binding="{Binding FirstSeen, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="{StaticResource Col.LastSeen}" Binding="{Binding LastSeen, StringFormat=g}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- IP map -->
            <TabItem Header="{DynamicResource Tab.IpMap}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <WrapPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="14" />
                                <Setter Property="Height" Value="14" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="Margin" Value="0,0,5,0" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,16,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </WrapPanel.Resources>
                        <Border Background="{StaticResource Brush.Free}" /><TextBlock Text="{DynamicResource Map.Legend.Free}" />
                        <Border Background="{StaticResource Brush.Known}" /><TextBlock Text="{DynamicResource Map.Legend.Known}" />
                        <Border Background="{StaticResource Brush.Unknown}" /><TextBlock Text="{DynamicResource Map.Legend.Unknown}" />
                        <Border Background="{StaticResource Brush.Conflict}" /><TextBlock Text="{DynamicResource Map.Legend.Conflict}" />
                        <Border Background="{StaticResource Brush.Reserved}" /><TextBlock Text="{DynamicResource Map.Legend.Reserved}" />
                        <Border Background="{StaticResource Brush.Infra}" /><TextBlock Text="{DynamicResource Map.Legend.Infra}" />
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding IpMap}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:IpTile}">
                                    <Border x:Name="Tile" Width="44" Height="34" Margin="2" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                                            Background="{StaticResource Brush.Free}"
                                            ToolTip="{Binding Tooltip}" Cursor="Hand"
                                            MouseLeftButtonUp="Tile_Click">
                                        <TextBlock x:Name="Label" Text="{Binding Label}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Muted}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Known}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Known}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Unknown}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Unknown}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Conflict}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Conflict}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Reserved}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Reserved}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Self}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Infra}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:IpState.Gateway}">
                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Infra}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Internet & critical devices -->
            <TabItem Header="{DynamicResource Tab.Health}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <!-- Status tiles: icon + label + value, never color alone -->
                    <UniformGrid Rows="1" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✔" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Online}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InternetUp}" Value="False">
                                                        <Setter Property="Text" Value="✖" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Unknown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding InternetStatusText}" Style="{StaticResource StatNumber}" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Health.Internet}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✔" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Online}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RouterUp}" Value="False">
                                                        <Setter Property="Text" Value="✖" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Unknown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RouterStatusText}" Style="{StaticResource StatNumber}" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Health.RouterLabel}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource StatNumber}" FontSize="18" />
                                <TextBlock Text="{DynamicResource Health.Uptime24}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding OutagesWeekText}" Style="{StaticResource StatNumber}" FontSize="18" />
                                <TextBlock Text="{DynamicResource Health.Outages7d}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✔" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Online}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CriticalAllUp}" Value="False">
                                                        <Setter Property="Text" Value="✖" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Unknown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CriticalSummaryText}" Style="{StaticResource StatNumber}" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Health.CriticalLabel}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chart controls + legend in one row above the chart -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Health.Range}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="110" SelectedValue="{Binding HealthRangeHours}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Health.Range1h}" Tag="{StaticResource Hours1}" />
                                <ComboBoxItem Content="{DynamicResource Health.Range6h}" Tag="{StaticResource Hours6}" />
                                <ComboBoxItem Content="{DynamicResource Health.Range24h}" Tag="{StaticResource Hours24}" />
                                <ComboBoxItem Content="{DynamicResource Health.Range7d}" Tag="{StaticResource Hours168}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Health.ChartTitle}" FontWeight="SemiBold" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="#2A78D6" Margin="0,0,5,0" />
                            <TextBlock Text="{DynamicResource Health.Internet}" Margin="0,0,14,0" />
                            <Ellipse Width="8" Height="8" Fill="#EB6834" Margin="0,0,5,0" />
                            <TextBlock Text="{DynamicResource Health.Router}" Margin="0,0,14,0" />
                            <Rectangle Width="12" Height="10" Fill="#2ED03B3B" Margin="0,0,5,0" />
                            <TextBlock Text="{DynamicResource Health.OutageLegend}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                        <controls:LatencyChart Samples="{Binding ChartSamples}" Start="{Binding ChartStart}" End="{Binding ChartEnd}" />
                    </Border>

                    <!-- Critical devices + outage history -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Health.CriticalTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Health.CriticalHint}" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <DataGrid x:Name="CriticalGrid" ItemsSource="{Binding CriticalView}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="24"
                                      HorizontalGridLinesBrush="{StaticResource Brush.Border}" BorderBrush="{StaticResource Brush.Border}"
                                      MouseDoubleClick="CriticalGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{StaticResource Col.Status}" Width="90" SortMemberPath="IsOnline">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold" Margin="4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{StaticResource Health.StatusUp}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Online}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Text" Value="{StaticResource Health.StatusDown}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Unknown}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{StaticResource Col.Name}" Binding="{Binding DisplayName}" Width="*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="{StaticResource Col.Ip}" Binding="{Binding Ip}" Width="105" />
                                    <DataGridTextColumn Header="{StaticResource Col.Ping}" Binding="{Binding PingMs, StringFormat={}{0} ms, TargetNullValue=—}" Width="60" />
                                    <DataGridTextColumn Header="{StaticResource Col.Since}" Binding="{Binding StatusSinceText}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Btn.ExportOutages}" Click="ExportOutages_Click" Margin="0" Padding="8,1" MinWidth="0" />
                                <TextBlock Text="{DynamicResource Health.OutagesTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Outages}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="24"
                                      HorizontalGridLinesBrush="{StaticResource Brush.Border}" BorderBrush="{StaticResource Brush.Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Col.What}" Binding="{Binding KindText}" Width="*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="{StaticResource Col.Start}" Binding="{Binding Start, StringFormat=g}" Width="130" />
                                    <DataGridTextColumn Header="{StaticResource Col.End}" Binding="{Binding End, StringFormat=t}" Width="80" />
                                    <DataGridTextColumn Header="{StaticResource Col.Duration}" Binding="{Binding DurationText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Events -->
            <TabItem Header="{DynamicResource Tab.Events}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Btn.ClearEvents}" Click="ClearEvents_Click" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                              BorderBrush="{StaticResource Brush.Border}" RowHeight="24">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.UnknownRow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Col.Time}" Binding="{Binding Time, StringFormat=G}" Width="150" />
                            <DataGridTextColumn Header="{StaticResource Col.Event}" Binding="{Binding KindText}" Width="120" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="{StaticResource Col.Ip}" Binding="{Binding Ip}" Width="110" />
                            <DataGridTextColumn Header="{StaticResource Col.Mac}" Binding="{Binding Mac}" Width="130" FontFamily="Consolas" />
                            <DataGridTextColumn Header="{StaticResource Col.Details}" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
