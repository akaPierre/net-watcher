<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Per-user package: installs to %LOCALAPPDATA%\Programs\Net Watcher without asking for admin rights.
       Keep UpgradeCode fixed forever; it is how new versions find and replace old ones. -->
  <Package Name="Net Watcher"
           Manufacturer="Net Watcher"
           Version="$(var.ProductVersion)"
           UpgradeCode="{6B1D2F6E-3C1A-4C55-9E0B-8B6E2A7D4F31}"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Net Watcher is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\NetWatcher\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- ===== Folders ===== -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Net Watcher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- ===== Files and shortcuts ===== -->
    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="{3E7A9C2B-5D14-4F6A-B8E2-1C9D0A4F7B63}">
      <File Id="NetWatcherExe" Source="$(var.AppPublishDir)\NetWatcher.exe" KeyPath="no" />
      <!-- Per-user components need an HKCU key as their key path. -->
      <RegistryValue Root="HKCU" Key="Software\NetWatcher\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveUserProgramsDir" Directory="UserProgramsDir" On="uninstall" /> <!-- only removed if empty -->
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="Net Watcher" Description="Office network inventory and monitoring"
                Target="[INSTALLFOLDER]NetWatcher.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\NetWatcher\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut" Name="Net Watcher" Description="Office network inventory and monitoring"
                Target="[INSTALLFOLDER]NetWatcher.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\NetWatcher\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Net Watcher">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ===== Close a running copy (it lives in the tray) before upgrading or uninstalling ===== -->
    <util:CloseApplication Id="CloseNetWatcher" Target="NetWatcher.exe"
                           CloseMessage="yes" TerminateProcess="1" Timeout="3" RebootPrompt="no" />

    <!-- ===== On uninstall (not upgrade): remove the "start with Windows" entry the app may have created ===== -->
    <SetProperty Id="RemoveStartupEntry" Sequence="execute" Before="RemoveStartupEntry"
                 Value="&quot;[System64Folder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v NetWatcher /f" />
    <CustomAction Id="RemoveStartupEntry" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveStartupEntry" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- ===== Wizard: welcome + terms, progress, finish with "Launch Net Watcher" ===== -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Net Watcher" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NetWatcherExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
