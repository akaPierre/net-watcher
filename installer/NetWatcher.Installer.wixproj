<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds NetWatcher-Setup-<version>.msi from the published single-file exe.
       Run ..\build.ps1 rather than building this directly: it publishes the app first. -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <OutputName>NetWatcher-Setup-$(ProductVersion)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);AppPublishDir=$(AppPublishDir)</DefineConstants>
    <!-- Per-user install into the user profile is intentional (no admin rights needed). -->
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
